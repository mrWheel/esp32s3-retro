  ///2Examples

  COPY A FILE FROM ONE DISK TO ANOTHER

       A>PIP b:1DD16            lxi h,workFcb
 03F3 112517            lxi d,sideFcb
 03F6 010C00            lxi b,12
 03F9 CDDB12            call copyBlock
 03FC 3E48              mvi a,'H'
 03FE 322E17            sta sideFcb+9
 0401 3E53              mvi a,'S'
 0403 322F17            sta sideFcb+10
 0406 3E54              mvi a,'T'
 0408 323017            sta sideFcb+11
 040B C9                ret
                
                commandDir:
 040C 3E01              mvi a,1
 040E CDDE0F            call sendByte
 0411 DADE10            jc operationAborted
 0414 CDD00F            call readByte
 0417 DADE10            jc operationAborted
 041A B7                ora a
 041B C20E11            jnz showHostError
 041E AF                xra a
 041F 329716            sta dirNameActive
                dirRead:
 0422 CDD00F            call readByte
 0425 DADE10            jc operationAborted
 0428 B7                ora a
 0429 CA4004            jz dirStringEnd
 042C 329A16            sta charValue
 042F 3E01              mvi a,1
 0431 329716            sta dirNameActive
 0434 3A9A16            lda charValue
 0437 5F                mov e,a
 0438 0E02              mvi c,2
 043A CD0500            call bdos
 043D C32204            jmp dirRead
                dirStringEnd:
 0440 3A9716            lda dirNameActive
 0443 B7                ora a
 0444 CA5104            jz dirListEnd
 0447 CDBE12            call printCrLf
 044A AF                xra a
 044B 329716            sta dirNameActive
 044E C32204            jmp dirRead
                dirListEnd:
 0451 CDD00F            call readByte
 0454 DADE10            jc operationAborted
 0457 B7                ora a
 0458 C20E11            jnz showHostError
 045B C3CD12            jmp terminate
                
                commandGetWildcard:
 045E AF                xra a
 045F 328B16            sta wildcardCount
 0462 21DE16            lxi h,workFcb+1
 0465 114917            lxi d,patternFcb
 0468 010B00            lxi b,11
 046B CDDB12            call copyBlock
 046E 3E01              mvi a,1
 0470 CDDE0F            call sendByte
 0473 DADE10            jc operationAborted
 0476 CDD00F            call readByte
 0479 DADE10            jc operationAborted
 047C B7                ora a
 047D C20E11            jnz showHostError
                getWildcardReadName:
 0480 AF                xra a
 0481 328E16            sta hostNameLength
 0484 328F16            sta hostNameOverflow
                getWildcardReadCharacter:
 0487 CDD00F            call readByte
 048A DADE10            jc operationAborted
 048D B7                ora a
 048E CAB904            jz getWildcardNameEnd
 0491 329A16            sta charValue
 0494 3A8E16            lda hostNameLength
 0497 FE0C              cpi 12
 0499 D2B104            jnc getWildcardNameOverflow
 049C 5F                mov e,a
 049D 1600              mvi d,0
 049F 215F17            lxi h,hostFilename
 04A2 19                dad d
 04A3 3A9A16            lda charValue
 04A6 77                mov m,a
 04A7 3A8E16            lda hostNameLength
 04AA 3C                inr a
 04AB 328E16            sta hostNameLength
 04AE C38704            jmp getWildcardReadCharacter
                getWildcardNameOverflow:
 04B1 3E01              mvi a,1
 04B3 328F16            sta hostNameOverflow
 04B6 C38704            jmp getWildcardReadCharacter
                getWildcardNameEnd:
