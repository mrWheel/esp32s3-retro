еееееееееееееееееееееееееееееееееее; HELP.ASM - CP/M-80 HELP utility
; 8080 source for Digital Research ASM.COM
; Version 2.1 - 2026-10-08
;
; Simple ASCII HLP format:
;
; ///1 PIP
; text for the main topic
;
; ///2 OPTIONS
; text for OPTIONS
;
; ///3 VERIFY
; text for VERIFY
;
; There is NO binary index. The .HLP file itself is the source.
; HELP reads it sequentially and recognizes lines:
;
; ///levelspacetopic
;
; Levels 1..9 are supported. Topic matching is case-insensitive.
;
; Usage:
; HELP
; HELP command
; HELP command topic [subtopic ...]
;
; HELP without arguments lists *.HLP on the current/default drive and
; enters the HELP> prompt. RETURN at an empty HELP> prompt exits.
;
; At HELP>:
; PIP opens PIP.HLP and shows its level-1 topic
; PIP OPTIONS opens PIP.HLP and shows OPTIONS below PIP
; .OPTIONS selects OPTIONS below the current topic
; RETURN exits HELP
;
; Text is paged after 20 displayed lines. At -- More --:
; RETURN continues, Q quits the displayed topic.
;
; Assemble:
; ASM HELP
; LOAD HELP
;
ORG 100H

BDOS EQU 0005H
FCB0 EQU 005CH
CMDLEN EQU 0080H
CMDTAIL EQU 0081H
DMA EQU 0080H

FCONOUT EQU 2
FPRINT EQU 9
FREADLN EQU 10
FOPEN EQU 15
FCLOSE EQU 16
FSFIRST EQU 17
FSNEXT EQU 18
FREAD EQU 20
F_SETDMA EQU 26

CR EQU 0DH
LF EQU 0AH
TAB EQU 09H
SPACE EQU 20H
EOFCHR EQU 1AH

; ----------------------------------------------------------------------
; Entry
; ----------------------------------------------------------------------

START:  LXI     SP,STACKTOP
        LXI     D,MSGBANNER
        CALL    PRINT
        CALL    PARSECMDL
DA NTOKENS
ORA A
JZ NOARGS

        CALL    OPENCMD    
        JC      CMDNOFILE    
        CALL    SHOWPATH    
        JMP     EXIT    

NOARGS: CALL BANNER
CALL LISTHLP

INTERACTIVE:
CALL PROMPT
CALL GETLINE
LDA LINELEN
ORA A
JZ EXIT

        CALL    PARSELINE    
        LDA     NTOKENS    
        ORA     A    
        JZ      EXIT    

        LXI     H,TOKBUF    
        MOV     A,M    
        CPI     '.'    
        JZ      DOTCMD    

        CALL    OPENCMD    
        JC      INTNOFILE    
        CALL    SHOWPATH    
        JMP     INTERACTIVE    

DOTCMD: LDA HAVEFILE
ORA A
JZ NOCURRENT
CALL BUILDDOT
CALL OPENLAST
JC INTNOFILE
CALL SHOWPATH
JMP INTERACTIVE

CMDNOFILE:
LXI D,MSGNOFILE
CALL PRINT
CALL PRINTFIRST
CALL CRLF
JMP EXIT

INTNOFILE:
LXI D,MSGNOFILE
CALL PRINT
CALL PRINTFIRST
CALL CRLF
JMP INTERACTIVE

NOCURRENT:
LXI D,MSGNOCUR
CALL PRINT
JMP INTERACTIVE

EXIT: RET

; ----------------------------------------------------------------------
; Console
; ----------------------------------------------------------------------

PRINT: MVI C,F_PRINT
JMP BDOS

PUTC: PUSH B
PUSH D
MOV E,A
MVI C,F_CONOUT
CALL BDOS
POP D
POP B
RET

CRLF: MVI A,CR
CALL PUTC
MVI A,LF
JMP PUTC

BANNER: LXI D,MSGBANNER
CALL PRINT
RET

PROMPT: LXI D,MSGPROMPT
CALL PRINT
RET

GETLINE:
LXI H,LINEBUF
MVI M,78
INX H
MVI M,0
LXI D,LINEBUF
MVI C,F_READLN
CALL BDOS
CALL CRLF
LDA LINEBUF+1
STA LINELEN
RET

UPPER: CPI 'a'
RC
CPI 'z'+1
RNC
SUI 20H
RET

; ----------------------------------------------------------------------
; Command line parser
; Tokens are stored as 8 slots of 13 bytes, zero terminated.
; ----------------------------------------------------------------------

PARSECMD:
LDA CMDLEN
STA REMAIN
LXI H,CMDTAIL
SHLD PARSEP
JMP PARSECOMMON

PARSELINE:
LDA LINELEN
STA REMAIN
LXI H,LINEBUF+2
SHLD PARSEP

PARSECOMMON:
XRA A
STA NTOKENS
LXI H,TOKBUF
SHLD TOKPUT

PCNEXT: CALL SKIPSP
LDA REMAIN
ORA A
RZ
LDA NTOKENS
CPI 8
RNC

        LHLD    TOKPUT    
        MVI     B,12    

PCTOK: LDA REMAIN
ORA A
JZ PCTEND
XCHG
LHLD PARSEP
MOV A,M
XCHG
CPI SPACE
JZ PCTEND
CPI TAB
JZ PCTEND
CALL UPPER
MOV M,A
INX H
SHLD TOKPUT
PUSH H
LHLD PARSEP
INX H
SHLD PARSEP
POP H
LDA REMAIN
DCR A
STA REMAIN
DCR B
JNZ PCTOK

; Token longer than 12: consume remainder.
PCDROP: LDA REMAIN
ORA A
JZ PCTEND
LHLD PARSEP
MOV A,M
CPI SPACE
JZ PCTEND
CPI TAB
JZ PCTEND
INX H
SHLD PARSEP
LDA REMAIN
DCR A
STA REMAIN
JMP PCDROP

PCTEND: LHLD TOKPUT
MVI M,0
INX H
; pad remainder of 13-byte slot
PCPAD: DCR B
JM PCPADDONE
MVI M,0
INX H
JMP PCPAD
PCPADDONE:
SHLD TOKPUT
LDA NTOKENS
INR A
STA NTOKENS
JMP PCNEXT

SKIPSP:
LDA REMAIN
ORA A
RZ
LHLD PARSEP
MOV A,M
CPI SPACE
JZ SKONE
CPI TAB
RNZ
SKONE: INX H
SHLD PARSEP
LDA REMAIN
DCR A
STA REMAIN
JMP SKIPSP

GETTOK:
; A = token number 0..7, returns HL
MOV B,A
LXI H,TOKBUF
MOV A,B
ORA A
RZ
GT1: LXI D,13
DAD D
DCR B
JNZ GT1
RET

PRINTFIRST:
XRA A
CALL GETTOK
PF1: MOV A,M
ORA A
RZ
CALL PUTC
INX H
JMP PF1

; ----------------------------------------------------------------------
; FCB handling
; ----------------------------------------------------------------------

CLEARFCB:
LXI H,FCB
MVI B,36
XRA A
CF1: MOV M,A
INX H
DCR B
JNZ CF1
RET

OPENCMD:
; First token is filename. Build ????????.HLP and remember it.
CALL CLEARFCB
XRA A
CALL GETTOK
LXI D,FCB+1
MVI B,8
OC1: MOV A,M
ORA A
JZ OCPAD
CPI '.'
JZ OCPAD
STAX D
INX H
INX D
DCR B
JNZ OC1
JMP OCEXT
OCPAD: MVI A,SPACE
OC2: STAX D
INX D
DCR B
JNZ OC2
OCEXT: MVI A,'H'
STAX D
INX D
MVI A,'L'
STAX D
INX D
MVI A,'P'
STAX D

        ; Save 11-byte CP/M name for .relative commands.    
        LXI     H,FCB+1    
        LXI     D,LASTNAME    
        MVI     B,11    

OCS: MOV A,M
STAX D
INX H
INX D
DCR B
JNZ OCS

        MVI     A,1    
        STA     HAVEFILE    
        CALL    OPENFCB    
        RET    

OPENLAST:
CALL CLEARFCB
LXI H,LASTNAME
LXI D,FCB+1
MVI B,11
OL1: MOV A,M
STAX D
INX H
INX D
DCR B
JNZ OL1
CALL OPENFCB
RET

OPENFCB:
LXI D,FCB
MVI C,F_OPEN
CALL BDOS
INR A
JZ OFBAD
XRA A
STA RECPOS
STA RECVALID
STA FILEEOF
ORA A
RET
OFBAD: STC
RET

CLOSEFCB:
LXI D,FCB
MVI C,F_CLOSE
CALL BDOS
RET

; ----------------------------------------------------------------------
; List *.HLP on current drive
; ----------------------------------------------------------------------

LISTHLP:
CALL CLEARFCB
LXI H,FCB+1
MVI B,8
MVI A,'?'
LH1: MOV M,A
INX H
DCR B
JNZ LH1
MVI M,'H'
INX H
MVI M,'L'
INX H
MVI M,'P'

        LXI     D,DMA    
        MVI     C,F_SETDMA    
        CALL    BDOS    

        LXI     D,FCB    
        MVI     C,F_SFIRST    
        CALL    BDOS    
        CPI     0FFH    
        JZ      LHNONE    
        XRA     A    
        STA     NCOLS    

LHLOOP:
CALL PRINTDIRENT
LXI D,FCB
MVI C,F_SNEXT
CALL BDOS
CPI 0FFH
JNZ LHLOOP
LDA NCOLS
ORA A
JZ LHDONE
CALL CRLF
LHDONE: CALL CRLF
RET

LHNONE: LXI D,MSGNOHLP
CALL PRINT
RET

PRINTDIRENT:
; BDOS returns A=directory slot 0..3 in DMA.
ANI 03H
ADD A
ADD A
ADD A
ADD A
ADD A ; *32
MOV E,A
MVI D,0
LXI H,DMA+1
DAD D
MVI B,8
PD1: MOV A,M
ANI 7FH
CPI SPACE
JZ PDSP
CALL PUTC
PDSP: INX H
DCR B
JNZ PD1

        ; pad display field to 12 columns    
        MVI     B,4    

PD2: MVI A,SPACE
CALL PUTC
DCR B
JNZ PD2

        LDA     NCOLS    
        INR     A    
        CPI     5    
        JC      PD3    
        XRA     A    
        STA     NCOLS    
        CALL    CRLF    
        RET    

PD3: STA NCOLS
RET

; ----------------------------------------------------------------------
; Sequential byte reader
; ----------------------------------------------------------------------

RESETREAD:
XRA A
STA RECPOS
STA RECVALID
STA FILEEOF
; Reset sequential extent fields in FCB.
STA FCB+12
STA FCB+14
STA FCB+32
RET

READREC:
LXI D,READBUF
MVI C,FSETDMA
CALL BDOS
LXI D,FCB
MVI C,FREAD
CALL BDOS
ORA A
JNZ RREOF
MVI A,128
STA RECVALID
XRA A
STA RECPOS
ORA A
RET
RREOF: MVI A,1
STA FILEEOF
STC
RET

NEXTBYTE:
LDA FILEEOF
ORA A
JNZ NBEOF
LDA RECVALID
ORA A
JZ NBREAD
LDA RECPOS
MOV E,A
MVI D,0
LXI H,READBUF
DAD D
MOV A,M
PUSH PSW
LDA RECPOS
INR A
CPI 128
JC NBPOS
XRA A
STA RECVALID
NBPOS: STA RECPOS
POP PSW
CPI EOFCHR
JZ NBEOFSET
ORA A ; clear carry
RET
NBREAD: CALL READREC
JC NBEOF
JMP NEXTBYTE
NBEOFSET:
MVI A,1
STA FILEEOF
NBEOF: STC
RET

; ----------------------------------------------------------------------
; Line reader
; Returns one logical ASCII line in HLP_LINE, zero terminated.
; Carry set only when EOF occurs before any character was read.
; CR and LF are not stored.
; ----------------------------------------------------------------------

; READLINE2 is the active line reader. Binary index bytes are ignored
; as non-topic lines until the first /// marker is reached.

GETBYTE:
LDA HAVEPEND
ORA A
JZ GB1
XRA A
STA HAVEPEND
LDA PENDING
ORA A
RET
GB1: JMP NEXTBYTE

READLINE2:
LXI H,HLP_LINE
MVI B,78
XRA A
STA GOTCHAR
RL21: CALL GETBYTE
JC RL2EOF
CPI CR
JZ RL2CR
CPI LF
JZ RL2END
CPI EOFCHR
JZ RL2EOF
STA LASTBYTE
MVI A,1
STA GOTCHAR
MOV A,B
ORA A
JZ RL21
LDA LASTBYTE
MOV M,A
INX H
DCR B
JMP RL21
RL2CR: CALL GETBYTE
JC RL2END
CPI LF
JZ RL2END
STA PENDING
MVI A,1
STA HAVEPEND
RL2END: MVI M,0
ORA A
RET
RL2EOF: LDA GOTCHAR
ORA A
JZ RL2EMPTY
MVI M,0
ORA A
RET
RL2EMPTY:
MVI M,0
STC
RET

; ----------------------------------------------------------------------
; Parse a topic marker.
; Input HLPLINE.
; On success: carry clear, TOPLEVEL=1..9, TOPNAME points into HLPLINE.
; On ordinary text: carry set.
; Accepts ///1 TOPIC and also multiple spaces/tabs after level.
; ----------------------------------------------------------------------

ISTOPIC:
LXI H,HLP_LINE
MOV A,M
CPI '/'
JNZ ITNO
INX H
MOV A,M
CPI '/'
JNZ ITNO
INX H
MOV A,M
CPI '/'
JNZ ITNO
INX H
MOV A,M
CPI '1'
JC ITNO
CPI '9'+1
JNC ITNO
SUI '0'
STA TOPLEVEL
INX H
MOV A,M
CPI SPACE
JZ ITSP
CPI TAB
JNZ ITNO
ITSP: INX H
MOV A,M
CPI SPACE
JZ ITSP
CPI TAB
JZ ITSP
MOV A,M
ORA A
JZ ITNO
SHLD TOPNAME
ORA A
RET
ITNO: STC
RET

; ----------------------------------------------------------------------
; Topic-name matching
; MATCHTOK: A=token number, TOPNAME=topic text.
; Exact match or unique prefix is handled by scanner.
; Returns zero for prefix match, nonzero otherwise.
; ----------------------------------------------------------------------

MATCHTOK:
CALL GETTOK
XCHG ; DE token
LHLD TOPNAME ; HL topic
MT1: LDAX D
ORA A
JZ MTYES
MOV B,A
MOV A,M
ORA A
JZ MTNO
CALL UPPER
MOV C,A
MOV A,B
CALL UPPER
CMP C
JNZ MTNO
INX D
INX H
JMP MT1
MTYES: XRA A
RET
MTNO: MVI A,1
ORA A
RET

; ----------------------------------------------------------------------
; SHOWPATH
; File already open. Token 0 is filename/command.
; If no topic tokens: show first level-1 topic.
; If topics supplied: find the requested hierarchy.
; ----------------------------------------------------------------------

SHOWPATH:
CALL RESETREAD
XRA A
STA HAVEPEND
STA CURLEVEL
STA FOUNDANY
MVI A,1
STA WANTTOK

        LDA     NTOKENS    
        CPI     1    
        JNZ     SPSEARCH    
        ; No explicit topic: find first level-1 marker.    
        MVI     A,1    
        STA     WANTLEVEL    
        JMP     SPFIRST    

SPSEARCH:
MVI A,2
STA WANTLEVEL

        ; First establish level-1 root. Prefer a root whose topic matches    
        ; command name, otherwise accept first level-1 topic.    

SPROOT: CALL READLINE2
JC SPNF
CALL ISTOPIC
JC SPROOT
LDA TOPLEVEL
CPI 1
JNZ SPROOT
; Save first root position logically by accepting it; per-command
; HLP files normally contain one level-1 root.
MVI A,1
STA CURLEVEL
JMP SPNEXTTOK

SPFIRST:
CALL READLINE2
JC SPNF
CALL ISTOPIC
JC SPFIRST
LDA TOPLEVEL
CPI 1
JNZ SPFIRST
MVI A,1
STA CURLEVEL
CALL SAVECURTOP
CALL SHOWBODY
CALL CLOSEFCB
RET

SPNEXTTOK:
LDA WANTTOK
MOV B,A
LDA NTOKENS
CMP B
JZ SPSHOWCURRENT

        ; Search forward for a direct child at CURLEVEL+1.    
        LDA     CURLEVEL    
        INR     A    
        STA     WANTLEVEL    
        XRA     A    
        STA     NMATCH    
        STA     SAVEDVALID    

SPSCAN: CALL READLINE2
JC SPENDSCAN
CALL ISTOPIC
JC SPSCAN

        LDA     TOPLEVEL    
        MOV     B,A    
        LDA     CURLEVEL    
        CMP     B    
        JNC     SPENDSCAN       ; same/higher ancestor => child range ended    

        LDA     WANTLEVEL    
        CMP     B    
        JNZ     SPSCAN    

        LDA     WANTTOK    
        CALL    MATCHTOK    
        ORA     A    
        JNZ     SPSCAN    

        ; Prefix match. Save topic text and count.    
        LDA     NMATCH    
        INR     A    
        STA     NMATCH    
        CALL    SAVELINE    
        JMP     SPSCAN    

SPENDSCAN:
LDA NMATCH
CPI 1
JNZ SPNF

        ; Rescan from beginning and find exact saved marker. Small files    
        ; make this simple and robust.    
        CALL    REOPENLAST    
        JC      SPNF    
        CALL    FINDSAVED    
        JC      SPNF    

        LDA     CURLEVEL    
        INR     A    
        STA     CURLEVEL    
        LDA     WANTTOK    
        INR     A    
        STA     WANTTOK    
        JMP     SPNEXTTOK    

SPSHOWCURRENT:
CALL SAVECURTOP
CALL SHOWBODY
CALL CLOSEFCB
RET

SPNF: CALL CLOSEFCB
LXI D,MSGTOPNF
CALL PRINT
RET

REOPENLAST:
CALL CLOSEFCB
CALL OPENLAST
RC
CALL RESETREAD
XRA A
STA HAVEPEND
RET

SAVELINE:
LXI H,HLP_LINE
LXI D,SAVEDLINE
MVI B,79
SL1: MOV A,M
STAX D
INX H
INX D
ORA A
RZ
DCR B
JNZ SL1
XRA A
STAX D
RET

FINDSAVED:
FSV1: CALL READLINE2
RC
LXI H,HLP_LINE
LXI D,SAVEDLINE
FSV2: MOV A,M
MOV B,A
LDAX D
CMP B
JNZ FSV1
ORA A
JZ FSVYES
INX H
INX D
JMP FSV2
FSVYES: ORA A
RET

SAVECURTOP:
; Remember the current marker line for .relative commands/display.
CALL SAVELINE
RET

; ----------------------------------------------------------------------
; SHOWBODY
; Called immediately after the selected ///n TOPIC line was read.
; Displays text until next topic marker or EOF.
; Then rescans to print direct child topics.
; ----------------------------------------------------------------------

SHOWBODY:
CALL CRLF
XRA A
STA PAGECNT

SB1: CALL READLINE2
JC SBEND
CALL ISTOPIC
JNC SBEND
CALL PRINTLINE
CALL PAGECHECK
JC SBQUIT
JMP SB1

SBEND: CALL CRLF
CALL SHOWCHILDREN
SBQUIT: RET

PRINTLINE:
LXI H,HLP_LINE
PL1: MOV A,M
ORA A
JZ PLEND
CALL PUTC
INX H
JMP PL1
PLEND: CALL CRLF
RET

PAGECHECK:
LDA PAGECNT
INR A
STA PAGECNT
CPI 20
RC
LXI D,MSGMORE
CALL PRINT
; Read one console char using BDOS function 1.
MVI C,1
CALL BDOS
CALL CRLF
CALL UPPER
CPI 'Q'
JZ PCQUIT
XRA A
STA PAGECNT
ORA A
RET
PCQUIT: STC
RET

SHOWCHILDREN:
; Reopen and locate SAVEDLINE, then list direct children.
CALL REOPENLAST
RC
CALL FINDSAVED
RC
LDA CURLEVEL
INR A
STA CHILDLEVEL
XRA A
STA CHILDCOUNT

SC1: CALL READLINE2
JC SCEND
CALL ISTOPIC
JC SC1
LDA TOPLEVEL
MOV B,A
LDA CURLEVEL
CMP B
JNC SCEND
LDA CHILDLEVEL
CMP B
JNZ SC1

        LDA     CHILDCOUNT    
        ORA     A    
        JNZ     SCNAME    
        LXI     D,MSGSUB    
        CALL    PRINT    

SCNAME: LHLD TOPNAME
SCN1: MOV A,M
ORA A
JZ SCSPACE
CALL PUTC
INX H
JMP SCN1
SCSPACE:
MVI A,SPACE
CALL PUTC
MVI A,SPACE
CALL PUTC
LDA CHILDCOUNT
INR A
STA CHILDCOUNT
JMP SC1

SCEND: LDA CHILDCOUNT
ORA A
RZ
CALL CRLF
CALL CRLF
RET

; ----------------------------------------------------------------------
; .TOPIC command
; Convert ".OPTIONS" into token list:
; token0 = current command filename (without extension)
; token1 = OPTIONS
; Additional tokens typed after .OPTIONS remain following it.
; For simplicity this implementation supports one relative component plus
; any already supplied following components.
; ----------------------------------------------------------------------

BUILDDOT:
; Shift tokens 0..n upward one slot, then install command token0.
LDA NTOKENS
MOV B,A
DCR B
BDLOOP: MOV A,B
CALL GETTOK
XCHG
MOV A,B
INR A
CALL GETTOK
; HL destination, DE source
MVI C,13
BDC1: LDAX D
MOV M,A
INX D
INX H
DCR C
JNZ BDC1
DCR B
JP BDLOOP

        ; token0 from LASTNAME first 8 chars, trim spaces    
        LXI     H,TOKBUF    
        LXI     D,LASTNAME    
        MVI     B,8    

BDN1: LDAX D
CPI SPACE
JZ BDNEND
MOV M,A
INX H
INX D
DCR B
JNZ BDN1
BDNEND: MVI M,0

        ; Remove leading '.' from token1.    
        MVI     A,1    
        CALL    GETTOK    
        MOV     A,M    
        CPI     '.'    
        JNZ     BDCOUNT    

BDDOT: INX H
MOV A,M
DCX H
MOV M,A
INX H
ORA A
JNZ BDDOT

BDCOUNT:
LDA NTOKENS
INR A
STA NTOKENS
RET

; ----------------------------------------------------------------------
; Data
; ----------------------------------------------------------------------

MSGBANNER:
DB CR,LF
DB 'CP/M Help System',CR,LF,CR,LF
DB 'Available help files:',CR,LF,CR,LF,'$'

MSGPROMPT:
DB 'HELP> $'

MSGNOHLP:
DB 'No .HLP files found on current drive.',CR,LF,CR,LF,'$'

MSGNOFILE:
DB 'No help file found for: $'

MSGNOCUR:
DB 'No current help topic. Enter a command first.',CR,LF,'$'

MSGTOPNF:
DB 'Help topic not found.',CR,LF,'$'

MSGSUB:
DB 'Subtopics:',CR,LF,' $'

MSGMORE:
DB '-- More -- RETURN=continue, Q=quit $'

; Parser state
PARSEP: DW 0
TOKPUT: DW 0
REMAIN: DB 0
NTOKENS: DB 0
LINELEN: DB 0

; File/topic state
HAVEFILE: DB 0
CURLEVEL: DB 0
WANTLEVEL: DB 0
WANTTOK: DB 0
TOPLEVEL: DB 0
TOPNAME: DW 0
NMATCH: DB 0
FOUNDANY: DB 0
SAVEDVALID: DB 0
CHILDLEVEL: DB 0
CHILDCOUNT: DB 0
PAGECNT: DB 0
NCOLS: DB 0

; Reader state
RECPOS: DB 0
RECVALID: DB 0
FILEEOF: DB 0
GOTCHAR: DB 0
HAVEPEND: DB 0
PENDING: DB 0
LASTBYTE: DB 0

; FCB and buffers
FCB: DS 36
LASTNAME: DS 11
TOKBUF: DS 104
LINEBUF: DS 82
HLP_LINE: DS 80
SAVEDLINE: DS 80
READBUF: DS 128

        DS      128    

STACKTOP EQU $

        END     START    
ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееHST1G␀␀З‚Wk#‡Nееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее

                ; HELP.ASM - CP/M-80 HELP utility
                ; 8080 source for Digital Research ASM.COM
                ; Version 2.1 - 2026-10-08
                ;
                ; Simple ASCII HLP format:
                ;
                ; ///1 PIP
                ; text for the main topic
                ;
                ; ///2 OPTIONS
                ; text for OPTIONS
                ;
                ; ///3 VERIFY
                ; text for VERIFY
                ;
                ; There is NO binary index. The .HLP file itself is the source.
                ; HELP reads it sequentially and recognizes lines:
                ;
                ; ///levelspacetopic
                ;
                ; Levels 1..9 are supported. Topic matching is case-insensitive.
                ;
                ; Usage:
                ; HELP
                ; HELP command
                ; HELP command topic [subtopic ...]
                ;
                ; HELP without arguments lists *.HLP on the current/default drive and
                ; enters the HELP> prompt. RETURN at an empty HELP> prompt exits.
                ;
                ; At HELP>:
                ; PIP opens PIP.HLP and shows its level-1 topic
                ; PIP OPTIONS opens PIP.HLP and shows OPTIONS below PIP
                ; .OPTIONS selects OPTIONS below the current topic
                ; RETURN exits HELP
                ;
                ; Text is paged after 20 displayed lines. At -- More --:
                ; RETURN continues, Q quits the displayed topic.
                ;
                ; Assemble:
                ; ASM HELP
                ; LOAD HELP
                ;
 0100           ORG 100H
                
 0005 =         BDOS EQU 0005H
 005C =         FCB0 EQU 005CH
 0080 =         CMDLEN EQU 0080H
 0081 =         CMDTAIL EQU 0081H
 0080 =         DMA EQU 0080H
                
 0002 =         FCONOUT EQU 2
 0009 =         FPRINT EQU 9
 000A =         FREADLN EQU 10
 000F =         FOPEN EQU 15
 0010 =         FCLOSE EQU 16
 0011 =         FSFIRST EQU 17
 0012 =         FSNEXT EQU 18
 0014 =         FREAD EQU 20
S               F_SETDMA EQU 26
                
 000D =         CR EQU 0DH
 000A =         LF EQU 0AH
 0009 =         TAB EQU 09H
 0020 =         SPACE EQU 20H
 001A =         EOFCHR EQU 1AH
                
                ; ----------------------------------------------------------------------
                ; Entry
                ; ----------------------------------------------------------------------
                
 0100 31DE0A    START:  LXI     SP,STACKTOP
 0103 119507            LXI     D,MSGBANNER
 0106 CD8C01            CALL    PRINT
U0109 CD0000            CALL    PARSECMDL
L               DA NTOKENS
 010C B7        ORA A
 010D CA1C01    JZ NOARGS
                
 0110 CDCC02            CALL    OPENCMD    
 0113 DA6401            JC      CMDNOFILE    
 0116 CD4605            CALL    SHOWPATH    
 0119 C38B01            JMP     EXIT    
                
 011C CDA601    NOARGS: CALL BANNER
 011F CD5203    CALL LISTHLP
                
                INTERACTIVE:
 0122 CDAD01    CALL PROMPT
 0125 CDB401    CALL GETLINE
 0128 3A8F08    LDA LINELEN
 012B B7        ORA A
 012C CA8B01    JZ EXIT
                
 012F CDE601            CALL    PARSELINE    
 0132 3A8E08            LDA     NTOKENS    
 0135 B7                ORA     A    
 0136 CA8B01            JZ      EXIT    
                
 0139 21D408            LXI     H,TOKBUF    
 013C 7E                MOV     A,M    
 013D FE2E              CPI     '.'    
 013F CA4E01            JZ      DOTCMD    
                
 0142 CDCC02            CALL    OPENCMD    
 0145 DA7301            JC      INTNOFILE    
 0148 CD4605            CALL    SHOWPATH    
 014B C32201            JMP     INTERACTIVE    
                
 014E 3A9008    DOTCMD: LDA HAVEFILE
 0151 B7        ORA A
 0152 CA8201    JZ NOCURRENT
 0155 CD4507    CALL BUILDDOT
 0158 CD1803    CALL OPENLAST
 015B DA7301    JC INTNOFILE
 015E CD4605    CALL SHOWPATH
 0161 C32201    JMP INTERACTIVE
                
                CMDNOFILE:
 0164 11F607    LXI D,MSGNOFILE
 0167 CD8C01    CALL PRINT
 016A CDB102    CALL PRINTFIRST
 016D CD9C01    CALL CRLF
 0170 C38B01    JMP EXIT
                
                INTNOFILE:
