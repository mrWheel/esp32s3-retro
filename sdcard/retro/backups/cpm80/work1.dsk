17800	
17900	     DISPLAY (3, 1) "THE AUDIBLE TONE SHOULD SOUND "
18000	                    "WHEN THIS MESSAGE IS PRINTED.".
18100	
18200	     DISPLAY (5, 1) "TYPE ANY CHARACTER TO CONTINUE.".
18300	
18400	     ACCEPT (, ) IN-CHAR  WITH AUTO-SKIP BEEP.
18500	
18600	
18700	
18800	
18900	 BLINK-TEST.
