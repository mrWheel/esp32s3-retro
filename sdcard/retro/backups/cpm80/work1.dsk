                ; ----------------------------------------------------------------------
                ; Parse a topic marker.
                ; Input HLPLINE.
                ; On success: carry clear, TOPLEVEL=1..9, TOPNAME points into HLPLINE.
                ; On ordinary text: carry set.
                ; Accepts ///1 TOPIC and also multiple spaces/tabs after level.
                ; ----------------------------------------------------------------------
                
                ISTOPIC:
E04D1 210000    LXI H,HLP_LINE
 04D4 7E        MOV A,M
 04D5 FE2F      CPI '/'
 04D7 C21B05    JNZ ITNO
 04DA 23        INX H
 04DB 7E        MOV A,M
 04DC FE2F      CPI '/'
 04DE C21B05    JNZ ITNO
 04E1 23        INX H
 04E2 7E        MOV A,M
 04E3 FE2F      CPI '/'
 04E5 C21B05    JNZ ITNO
 04E8 23        INX H
 04E9 7E        MOV A,M
 04EA FE31      CPI '1'
 04EC DA1B05    JC ITNO
 04EF FE3A      CPI '9'+1
 04F1 D21B05    JNC ITNO
 04F4 D630      SUI '0'
 04F6 329408    STA TOPLEVEL
 04F9 23        INX H
 04FA 7E        MOV A,M
 04FB FE20      CPI SPACE
 04FD CA0505    JZ ITSP
 0500 FE09      CPI TAB
 0502 C21B05    JNZ ITNO
 0505 23        ITSP: INX H
 0506 7E        MOV A,M
 0507 FE20      CPI SPACE
 0509 CA0505    JZ ITSP
 050C FE09      CPI TAB
 050E CA0505    JZ ITSP
 0511 7E        MOV A,M
 0512 B7        ORA A
 0513 CA1B05    JZ ITNO
 0516 229508    SHLD TOPNAME
 0519 B7        ORA A
 051A C9        RET
 051B 37        ITNO: STC
 051C C9        RET
                
                ; ----------------------------------------------------------------------
                ; Topic-name matching
                ; MATCHTOK: A=token number, TOPNAME=topic text.
                ; Exact match or unique prefix is handled by scanner.
                ; Returns zero for prefix match, nonzero otherwise.
                ; ----------------------------------------------------------------------
                
                MATCHTOK:
 051D CDA102    CALL GETTOK
 0520 EB        XCHG ; DE token
 0521 2A9508    LHLD TOPNAME ; HL topic
 0524 1A        MT1: LDAX D
 0525 B7        ORA A
 0526 CA4005    JZ MTYES
 0529 47        MOV B,A
 052A 7E        MOV A,M
 052B B7        ORA A
 052C CA4205    JZ MTNO
 052F CDCE01    CALL UPPER
 0532 4F        MOV C,A
 0533 78        MOV A,B
 0534 CDCE01    CALL UPPER
 0537 B9        CMP C
 0538 C24205    JNZ MTNO
 053B 13        INX D
 053C 23        INX H
 053D C32405    JMP MT1
 0540 AF        MTYES: XRA A
 0541 C9        RET
 0542 3E01      MTNO: MVI A,1
 0544 B7        ORA A
 0545 C9        RET
                
                ; ----------------------------------------------------------------------
                ; SHOWPATH
                ; File already open. Token 0 is filename/command.
                ; If no topic tokens: show first level-1 topic.
                ; If topics supplied: find the requested hierarchy.
                ; ----------------------------------------------------------------------
                
                SHOWPATH:
 0546 CDE803    CALL RESETREAD
 0549 AF        XRA A
 054A 32A208    STA HAVEPEND
 054D 329108    STA CURLEVEL
 0550 329808    STA FOUNDANY
 0553 3E01      MVI A,1
 0555 329308    STA WANTTOK
                
 0558 3A8E08            LDA     NTOKENS    
 055B FE01              CPI     1    
 055D C26805            JNZ     SPSEARCH    
                        ; No explicit topic: find first level-1 marker.    
 0560 3E01              MVI     A,1    
 0562 329208            STA     WANTLEVEL    
 0565 C38905            JMP     SPFIRST    
                
                SPSEARCH:
 0568 3E02      MVI A,2
 056A 329208    STA WANTLEVEL
                
                        ; First establish level-1 root. Prefer a root whose topic matches    
                        ; command name, otherwise accept first level-1 topic.    
                
 056D CD7704    SPROOT: CALL READLINE2
 0570 DA2906    JC SPNF
 0573 CDD104    CALL ISTOPIC
 0576 DA6D05    JC SPROOT
 0579 3A9408    LDA TOPLEVEL
 057C FE01      CPI 1
 057E C26D05    JNZ SPROOT
                ; Save first root position logically by accepting it; per-command
                ; HLP files normally contain one level-1 root.
 0581 3E01      MVI A,1
 0583 329108    STA CURLEVEL
 0586 C3AC05    JMP SPNEXTTOK
                
                SPFIRST:
 0589 CD7704    CALL READLINE2
 058C DA2906    JC SPNF
 058F CDD104    CALL ISTOPIC
 0592 DA8905    JC SPFIRST
 0595 3A9408    LDA TOPLEVEL
 0598 FE01      CPI 1
 059A C28905    JNZ SPFIRST
 059D 3E01      MVI A,1
 059F 329108    STA CURLEVEL
 05A2 CD7306    CALL SAVECURTOP
 05A5 CD7706    CALL SHOWBODY
 05A8 CD4903    CALL CLOSEFCB
 05AB C9        RET
                
                SPNEXTTOK:
 05AC 3A9308    LDA WANTTOK
 05AF 47        MOV B,A
 05B0 3A8E08    LDA NTOKENS
 05B3 B8        CMP B
 05B4 CA1F06    JZ SPSHOWCURRENT
                
                        ; Search forward for a direct child at CURLEVEL+1.    
 05B7 3A9108            LDA     CURLEVEL    
 05BA 3C                INR     A    
 05BB 329208            STA     WANTLEVEL    
 05BE AF                XRA     A    
 05BF 329708            STA     NMATCH    
 05C2 329908            STA     SAVEDVALID    
                
 05C5 CD7704    SPSCAN: CALL READLINE2
 05C8 DAFA05    JC SPENDSCAN
 05CB CDD104    CALL ISTOPIC
 05CE DAC505    JC SPSCAN
                
 05D1 3A9408            LDA     TOPLEVEL    
 05D4 47                MOV     B,A    
 05D5 3A9108            LDA     CURLEVEL    
 05D8 B8                CMP     B    
 05D9 D2FA05            JNC     SPENDSCAN       ; same/higher ancestor => child range ended    
                
 05DC 3A9208            LDA     WANTLEVEL    
 05DF B8                CMP     B    
 05E0 C2C505            JNZ     SPSCAN    
                
 05E3 3A9308            LDA     WANTTOK    
 05E6 CD1D05            CALL    MATCHTOK    
 05E9 B7                ORA     A    
 05EA C2C505            JNZ     SPSCAN    
                
                        ; Prefix match. Save topic text and count.    
 05ED 3A9708            LDA     NMATCH    
 05F0 3C                INR     A    
 05F1 329708            STA     NMATCH    
 05F4 CD4206            CALL    SAVELINE    
 05F7 C3C505            JMP     SPSCAN    
                
                SPENDSCAN:
 05FA 3A9708    LDA NMATCH
 05FD FE01      CPI 1
 05FF C22906    JNZ SPNF
                
                        ; Rescan from beginning and find exact saved marker. Small files    
                        ; make this simple and robust.    
 0602 CD3306            CALL    REOPENLAST    
 0605 DA2906            JC      SPNF    
 0608 CD5706            CALL    FINDSAVED    
 060B DA2906            JC      SPNF    
                
 060E 3A9108            LDA     CURLEVEL    
 0611 3C                INR     A    
 0612 329108            STA     CURLEVEL    
 0615 3A9308            LDA     WANTTOK    
 0618 3C                INR     A    
 0619 329308            STA     WANTTOK    
 061C C3AC05            JMP     SPNEXTTOK    
                
                SPSHOWCURRENT:
 061F CD7306    CALL SAVECURTOP
 0622 CD7706    CALL SHOWBODY
 0625 CD4903    CALL CLOSEFCB
 0628 C9        RET
                
 0629 CD4903    SPNF: CALL CLOSEFCB
 062C 113F08    LXI D,MSGTOPNF
 062F CD8C01    CALL PRINT
 0632 C9        RET
                
                REOPENLAST:
 0633 CD4903    CALL CLOSEFCB
 0636 CD1803    CALL OPENLAST
 0639 D8        RC
 063A CDE803    CALL RESETREAD
 063D AF        XRA A
 063E 32A208    STA HAVEPEND
 0641 C9        RET
                
                SAVELINE:
E0642 210000    LXI H,HLP_LINE
 0645 118E09    LXI D,SAVEDLINE
 0648 064F      MVI B,79
 064A 7E        SL1: MOV A,M
 064B 12        STAX D
 064C 23        INX H
 064D 13        INX D
 064E B7        ORA A
 064F C8        RZ
 0650 05        DCR B
 0651 C24A06    JNZ SL1
 0654 AF        XRA A
 0655 12        STAX D
 0656 C9        RET
                
                FINDSAVED:
 0657 CD7704    FSV1: CALL READLINE2
 065A D8        RC
E065B 210000    LXI H,HLP_LINE
 065E 118E09    LXI D,SAVEDLINE
 0661 7E        FSV2: MOV A,M
 0662 47        MOV B,A
 0663 1A        LDAX D
 0664 B8        CMP B
 0665 C25706    JNZ FSV1
 0668 B7        ORA A
 0669 CA7106    JZ FSVYES
 066C 23        INX H
 066D 13        INX D
 066E C36106    JMP FSV2
 0671 B7        FSVYES: ORA A
 0672 C9        RET
                
                SAVECURTOP:
                ; Remember the current marker line for .relative commands/display.
 0673 CD4206    CALL SAVELINE
 0676 C9        RET
                
                ; ----------------------------------------------------------------------
                ; SHOWBODY
                ; Called immediately after the selected ///n TOPIC line was read.
                ; Displays text until next topic marker or EOF.
                ; Then rescans to print direct child topics.
                ; ----------------------------------------------------------------------
                
                SHOWBODY:
 0677 CD9C01    CALL CRLF
 067A AF        XRA A
 067B 329C08    STA PAGECNT
                
 067E CD7704    SB1: CALL READLINE2
 0681 DA9606    JC SBEND
 0684 CDD104    CALL ISTOPIC
 0687 D29606    JNC SBEND
 068A CD9D06    CALL PRINTLINE
 068D CDB006    CALL PAGECHECK
 0690 DA9C06    JC SBQUIT
 0693 C37E06    JMP SB1
                
 0696 CD9C01    SBEND: CALL CRLF
 0699 CDD806    CALL SHOWCHILDREN
 069C C9        SBQUIT: RET
                
                PRINTLINE:
E069D 210000    LXI H,HLP_LINE
 06A0 7E        PL1: MOV A,M
 06A1 B7        ORA A
 06A2 CAAC06    JZ PLEND
 06A5 CD9101    CALL PUTC
 06A8 23        INX H
 06A9 C3A006    JMP PL1
 06AC CD9C01    PLEND: CALL CRLF
 06AF C9        RET
                
                PAGECHECK:
 06B0 3A9C08    LDA PAGECNT
 06B3 3C        INR A
 06B4 329C08    STA PAGECNT
 06B7 FE14      CPI 20
 06B9 D8        RC
 06BA 116508    LXI D,MSGMORE
 06BD CD8C01    CALL PRINT
                ; Read one console char using BDOS function 1.
 06C0 0E01      MVI C,1
 06C2 CD0500    CALL BDOS
 06C5 CD9C01    CALL CRLF
 06C8 CDCE01    CALL UPPER
 06CB FE51      CPI 'Q'
 06CD CAD606    JZ PCQUIT
 06D0 AF        XRA A
 06D1 329C08    STA PAGECNT
 06D4 B7        ORA A
 06D5 C9        RET
 06D6 37        PCQUIT: STC
 06D7 C9        RET
                
                SHOWCHILDREN:
                ; Reopen and locate SAVEDLINE, then list direct children.
 06D8 CD3306    CALL REOPENLAST
 06DB D8        RC
 06DC CD5706    CALL FINDSAVED
 06DF D8        RC
 06E0 3A9108    LDA CURLEVEL
 06E3 3C        INR A
 06E4 329A08    STA CHILDLEVEL
 06E7 AF        XRA A
 06E8 329B08    STA CHILDCOUNT
                
 06EB CD7704    SC1: CALL READLINE2
 06EE DA3907    JC SCEND
 06F1 CDD104    CALL ISTOPIC
 06F4 DAEB06    JC SC1
 06F7 3A9408    LDA TOPLEVEL
 06FA 47        MOV B,A
 06FB 3A9108    LDA CURLEVEL
 06FE B8        CMP B
 06FF D23907    JNC SCEND
 0702 3A9A08    LDA CHILDLEVEL
 0705 B8        CMP B
 0706 C2EB06    JNZ SC1
                
 0709 3A9B08            LDA     CHILDCOUNT    
 070C B7                ORA     A    
 070D C21607            JNZ     SCNAME    
 0710 115708            LXI     D,MSGSUB    
 0713 CD8C01            CALL    PRINT    
                
 0716 2A9508    SCNAME: LHLD TOPNAME
 0719 7E        SCN1: MOV A,M
 071A B7        ORA A
 071B CA2507    JZ SCSPACE
 071E CD9101    CALL PUTC
 0721 23        INX H
 0722 C31907    JMP SCN1
                SCSPACE:
 0725 3E20      MVI A,SPACE
 0727 CD9101    CALL PUTC
 072A 3E20      MVI A,SPACE
 072C CD9101    CALL PUTC
 072F 3A9B08    LDA CHILDCOUNT
 0732 3C        INR A
 0733 329B08    STA CHILDCOUNT
 0736 C3EB06    JMP SC1
                
 0739 3A9B08    SCEND: LDA CHILDCOUNT
 073C B7        ORA A
 073D C8        RZ
 073E CD9C01    CALL CRLF
 0741 CD9C01    CALL CRLF
 0744 C9        RET
                
                ; ----------------------------------------------------------------------
                ; .TOPIC command
                ; Convert ".OPTIONS" into token list:
                ; token0 = current command filename (without extension)
                ; token1 = OPTIONS
                ; Additional tokens typed after .OPTIONS remain following it.
                ; For simplicity this implementation supports one relative component plus
                ; any already supplied following components.
                ; ----------------------------------------------------------------------
                
                BUILDDOT:
                ; Shift tokens 0..n upward one slot, then install command token0.
 0745 3A8E08    LDA NTOKENS
 0748 47        MOV B,A
 0749 05        DCR B
 074A 78        BDLOOP: MOV A,B
 074B CDA102    CALL GETTOK
 074E EB        XCHG
 074F 78        MOV A,B
 0750 3C        INR A
 0751 CDA102    CALL GETTOK
                ; HL destination, DE source
 0754 0E0D      MVI C,13
 0756 1A        BDC1: LDAX D
 0757 77        MOV M,A
 0758 13        INX D
 0759 23        INX H
 075A 0D        DCR C
 075B C25607    JNZ BDC1
 075E 05        DCR B
 075F F24A07    JP BDLOOP
                
                        ; token0 from LASTNAME first 8 chars, trim spaces    
 0762 21D408            LXI     H,TOKBUF    
 0765 11C908            LXI     D,LASTNAME    
 0768 0608              MVI     B,8    
                
 076A 1A        BDN1: LDAX D
 076B FE20      CPI SPACE
 076D CA7707    JZ BDNEND
 0770 77        MOV M,A
 0771 23        INX H
 0772 13        INX D
 0773 05        DCR B
 0774 C26A07    JNZ BDN1
 0777 3600      BDNEND: MVI M,0
                
                        ; Remove leading '.' from token1.    
 0779 3E01              MVI     A,1    
 077B CDA102            CALL    GETTOK    
 077E 7E                MOV     A,M    
 077F FE2E              CPI     '.'    
 0781 C28D07            JNZ     BDCOUNT    
                
 0784 23        BDDOT: INX H
 0785 7E        MOV A,M
 0786 2B        DCX H
 0787 77        MOV M,A
 0788 23        INX H
 0789 B7        ORA A
 078A C28407    JNZ BDDOT
                
                BDCOUNT:
 078D 3A8E08    LDA NTOKENS
 0790 3C        INR A
 0791 328E08    STA NTOKENS
 0794 C9        RET
                
                ; ----------------------------------------------------------------------
                ; Data
                ; ----------------------------------------------------------------------
                
                MSGBANNER:
 0795 0D0A      DB CR,LF
 0797 43502F4D20DB 'CP/M Help System',CR,LF,CR,LF
 07AB 417661696CDB 'Available help files:',CR,LF,CR,LF,'$'
                
                MSGPROMPT:
1006B0003A9C083C329C08FE14D8116508CD8C0188
:1006C0000E01CD0500CD9C01CDCE01FE51CAD6064E
:1006D000AF329C08B7C937C9CD3306D8CD5706D835
:1006E0003A91083C329A08AF329B08CD7704DA3948
:1006F00007CDD104DAEB063A9408473A9108B8D20C
:1007000039073A9A08B8C2EB063A9B08B7C21607EF
:10071000115708CD8C012A95087EB7CA2507CD91BF
:100720000123C319073E20CD91013E20CD91013A0E
:100730009B083C329B08C3EB063A9B08B7C8CD9C8C
:1007400001CD9C01C93A8E08470578CDA102EB780E
:100750003CCDA1020E0D1A7713230DC2560705F2E8
:100760004A0721D40811C90806081AFE20CA7707CB
:1007700077231305C26A0736003E01CDA1027EFE33
:100780002EC28D07237E2B7723B7C284073A8E08AB
:100790003C328E08C90D0A43502F4D2048656C70BD
:1007A0002053797374656D0D0A0D0A417661696C89
:1007B00061626C652068656C702066696C65733A6F
:1007C0000D0A0D0A2448454C503E20244E6F202E21
:1007D000484C502066696C657320666F756E6420A6
:1007E0006F6E2063757272656E74206472697665CF
:1007F0002E0D0A0D0A244E6F2068656C7020666904
:100800006C6520666F756E6420666F723A20244EA8
:100810006F2063757272656E742068656C702074E9
:100820006F7069632E20456E746572206120636F5E
:100830006D6D616E642066697273742E0D0A2448B2
:10084000656C7020746F706963206E6F7420666FC2
:10085000756E642E0D0A24537562746F706963732C
:100860003A0D0A20242D2D204D6F7265202D2D204C
:1008700052455455524E3D636F6E74696E75652CCA
:1008800020513D71756974202400000000000000B3
:100890000000000000000000000000000000000058
:0508A000000000000053
:00010000FF
ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее 07C5 48454C503EDB 'HELP> $'
                
                MSGNOHLP:
 07CC 4E6F202E48DB 'No .HLP files found on current drive.',CR,LF,CR,LF,'$'
                
                MSGNOFILE:
 07F6 4E6F206865DB 'No help file found for: $'
                
                MSGNOCUR:
 080F 4E6F206375DB 'No current help topic. Enter a command first.',CR,LF,'$'
                
                MSGTOPNF:
 083F 48656C7020DB 'Help topic not found.',CR,LF,'$'
                
                MSGSUB:
 0857 537562746FDB 'Subtopics:',CR,LF,' $'
                
                MSGMORE:
 0865 2D2D204D6FDB '-- More -- RETURN=continue, Q=quit $'
                
                ; Parser state
 0889 0000      PARSEP: DW 0
 088B 0000      TOKPUT: DW 0
 088D 00        REMAIN: DB 0
 088E 00        NTOKENS: DB 0
 088F 00        LINELEN: DB 0
                
                ; File/topic state
 0890 00        HAVEFILE: DB 0
 0891 00        CURLEVEL: DB 0
 0892 00        WANTLEVEL: DB 0
 0893 00        WANTTOK: DB 0
 0894 00        TOPLEVEL: DB 0
 0895 0000      TOPNAME: DW 0
 0897 00        NMATCH: DB 0
 0898 00        FOUNDANY: DB 0
 0899 00        SAVEDVALID: DB 0
 089A 00        CHILDLEVEL: DB 0
 089B 00        CHILDCOUNT: DB 0
 089C 00        PAGECNT: DB 0
 089D 00        NCOLS: DB 0
                
                ; Reader state
 089E 00        RECPOS: DB 0
 089F 00        RECVALID: DB 0
 08A0 00        FILEEOF: DB 0
 08A1 00        GOTCHAR: DB 0
 08A2 00        HAVEPEND: DB 0
 08A3 00        PENDING: DB 0
 08A4 00        LASTBYTE: DB 0
                
                ; FCB and buffers
 08A5           FCB: DS 36
 08C9           LASTNAME: DS 11
 08D4           TOKBUF: DS 104
 093C           LINEBUF: DS 82
S               HLP_LINE: DS 80
 098E           SAVEDLINE: DS 80
 09DE           READBUF: DS 128
                
 0A5E                   DS      128    
                
 0ADE =         STACKTOP EQU $
                
 0ADE                   END     START    
