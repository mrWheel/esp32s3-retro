menu "Retro Host hardware"
  config RETRO_SD_MOSI
    int "SD SPI MOSI GPIO"
    range 0 48
    default 11
  config RETRO_SD_MISO
    int "SD SPI MISO GPIO"
    range 0 48
    default 13
  config RETRO_SD_CLK
    int "SD SPI clock GPIO"
    range 0 48
    default 12
  config RETRO_SD_CS
    int "SD SPI chip select GPIO"
    range 0 48
    default 10
endmenu

menu "CP/M-86 diagnostics"
  config CPM86_INSTRUCTION_TRACE
    bool "Capture instruction traces and opcode text"
    default y
    help
      Keep CP/M-86 instruction history and format decoded opcode bytes for
      diagnostic reports. Disable this option to measure CPU execution without
      instruction trace collection and formatting.
endmenu
