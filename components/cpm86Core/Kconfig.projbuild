menu "CP/M-86 (tiny8086 core)"

    config CPM86_TINY8086_IRAM
        bool "Place the 8086 interpreter in internal RAM"
        default y
        help
            Puts the whole tiny8086 object (code and its jump/parity tables) in IRAM/DRAM
            instead of flash-cached memory. Costs roughly 30 KB of IRAM; measured as
            clearly faster on the ESP32-S3.

endmenu
