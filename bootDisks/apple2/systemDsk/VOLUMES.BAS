10 REM LIST PRODOS VOLUMES IN LOGICAL SLOTS 6 AND 5
20 TEXT: NORMAL: HOME
30 IF PEEK(48896)<>76 THEN PRINT "ProDOS is required.": END
40 FOR I=768 TO 781: READ B: POKE I,B: NEXT I
45 FOR I=784 TO 797: READ B: POKE I,B: NEXT I
50 POKE 800,2: POKE 802,48: POKE 803,3
60 N=PEEK(48945)
70 PRINT "VOLUMES IN SLOTS 6 AND 5": PRINT
80 FOR S=6 TO 5 STEP -1
90 PRINT "SLOT ";S: F=0
100 IF N>127 THEN 170
105 FOR D=1 TO 2
110 FOR K=0 TO N
120 U=PEEK(48946+K): U=INT(U/16)*16
130 T=S*16+(D-1)*128
150 IF U=T THEN GOSUB 300
160 NEXT K
165 NEXT D
170 IF F=0 THEN PRINT "     No known ProDOS drives."
180 PRINT: NEXT S
190 END
300 F=1: POKE 801,U: POKE 804,0
310 CALL 768: E=PEEK(804)
320 PRINT "     D";D;" : ";
330 IF E<>0 THEN GOTO 400
340 L=PEEK(816): L=L-INT(L/16)*16
350 IF L=0 THEN PRINT "No volume name returned.": RETURN
360 V$=""
370 FOR J=1 TO L: V$=V$+CHR$(PEEK(816+J)): NEXT J
380 PRINT "/";V$: GOSUB 500: RETURN
400 IF E=40 THEN PRINT "No device connected.": RETURN
410 IF E=47 THEN PRINT "Drive offline / no disk.": RETURN
420 IF E=39 THEN PRINT "Disk I/O error.": RETURN
430 IF E=82 THEN PRINT "Not a ProDOS disk.": RETURN
440 IF E=87 THEN PRINT "Duplicate volume name.": RETURN
450 PRINT "ProDOS error ";E: RETURN
500 POKE 832,10: POKE 833,96: POKE 834,3
510 POKE 864,L+1: POKE 865,47
520 FOR J=1 TO L: POKE 865+J,ASC(MID$(V$,J,1)): NEXT J
530 CALL 784: E=PEEK(804)
540 IF E<>0 THEN PRINT "          Space info error ";E: RETURN
550 TB=PEEK(837)+256*PEEK(838)
560 UB=PEEK(840)+256*PEEK(841): FB=TB-UB
570 PRINT "          TOTAL: ";TB;" blocks / ";TB/2;" KiB"
580 PRINT "          USED : ";UB;" blocks / ";UB/2;" KiB"
590 PRINT "          FREE : ";FB;" blocks / ";FB/2;" KiB"
600 RETURN
1000 DATA 32,0,191,197,32,3,176,2,169,0,141,36,3,96
1010 DATA 32,0,191,196,64,3,176,2,169,0,141,36,3,96
