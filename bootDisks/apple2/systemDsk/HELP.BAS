10 TEXT: NORMAL: HOME
20 PRINT "Type ";CHR$(34);"DISK";CHR$(34);" or ";CHR$(34);"BASIC";CHR$(34);" for HELP"
30 PRINT "on those subjects or ";CHR$(34);"Quit";CHR$(34);" to Quit"
40 PRINT: INPUT "> ";A$
50 FOR I=1 TO LEN(A$): C=ASC(MID$(A$,I,1))
60 IF C>=97 AND C<=122 THEN A$=LEFT$(A$,I-1)+CHR$(C-32)+MID$(A$,I+1)
70 NEXT I
80 IF A$="QUIT" THEN NORMAL: END
90 IF A$="DISK" THEN S=1: GOTO 130
100 IF A$="BASIC" THEN S=2: GOTO 130
110 PRINT "Please type DISK, BASIC, or Quit.": GOTO 40
130 RESTORE
140 READ T$: IF T$<>"@DISK" THEN 140
150 IF S=1 THEN 200
160 READ T$: IF T$<>"@BASIC" THEN 160
200 HOME: N=0
210 READ T$: IF T$="@END" THEN 280
220 IF N<20 THEN 240
230 GOSUB 500: IF Q THEN 10
235 FOR J=1 TO LEN(T$): IF MID$(T$,J,1)=CHR$(124) THEN T$=LEFT$(T$,J-1)+CHR$(34)+MID$(T$,J+1)
237 NEXT J
240 PRINT T$: N=N+1: GOTO 210
280 PRINT: PRINT "End of topic. Press any key for menu.";
290 GET K$: GOTO 10
500 PRINT: PRINT "SPACE: next page   Q: menu";
510 GET K$: Q=0
520 IF K$="Q" OR K$="q" THEN Q=1: RETURN
530 IF K$<>" " THEN 510
540 HOME: N=0: RETURN
