10  REM === APPLESOFT FULL FUNCTIONALITY TEST ===
20  ONERR GOTO 9000: REM TEST ERROR HANDLING
30  HOME : PRINT "STARTING FULL APPLESOFT TEST...": PRINT 

100 REM --- TEST 1: MATHEMATICAL FUNCTIONS ---
110 PRINT "TEST 1: MATH... ";
120 A = ABS(-5):B = INT(5.9):C = SQR(16):D = SGN(-10)
130 E = LOG(1):F = EXP(0):G = INT(RND(1) * 10)
140 IF A<>5 OR B<>5 OR C<>4 OR D<>-1 OR E<>0 OR F<>1 THEN GOTO 999
150 PRINT "OK"

200 REM --- TEST 2: TRIGONOMETRY & PRECISION ---
210 PRINT "TEST 2: TRIG... ";
220 PI = 3.14159265:X = SIN(PI/2):Y = COS(0):Z = TAN(0)
230 IF ABS(X-1) > 0.00001 OR ABS(Y-1) > 0.00001 OR Z<>0 THEN GOTO 999
240 PRINT "OK"

300 REM --- TEST 3: STRINGS AND MANIPULATION ---
310 PRINT "TEST 3: STRINGS... ";
320 A$ = "APPLESOFT":B$ = "BASIC"
330 C$ = LEFT$(A$,5):D$ = RIGHT$(B$,4):E$ = MID$(A$,6,2)
340 L = LEN(A$):V = VAL("123"):S$ = STR$(456)
350 IF C$<>"APPLE" OR D$<>"ASIC" OR E$<>"SO" OR L<>9 OR V<>123 OR S$<>"456" THEN GOTO 999
360 PRINT "OK"

400 REM --- TEST 4: ARRAYS & FOR-NEXT LOOPS ---
410 PRINT "TEST 4: LOOPS/ARRAYS... ";
420 DIM M%(5):T = 0
430 FOR I = 1 TO 5:M%(I) = I * 2:NEXT I
440 FOR I = 1 TO 5:T = T + M%(I):NEXT I
450 IF T <> 30 THEN GOTO 999
460 PRINT "OK"

470 REM --- TEST 5: SCREEN AND LAYOUT COMMANDS ---
471 PRINT "TEST 5: SCREEN LAYOUT... ";
472 INVERSE : PRINT "VISUAL";: NORMAL : PRINT " (SCREEN WILL FLICKER)..."
473 FOR W = 1 TO 2000: NEXT W: REM SHORT PAUSE
474 HOME 
475 VTAB 5: HTAB 10: PRINT "X";: REM CURSOR TO ROW 5, COL 10
476 HP = POS(0): REM READ HORIZONTAL CURSOR POSITION (MUST BE 10)
477 VTAB 10: HTAB 1: PRINT "SPC-TEST:";: PRINT SPC(5);"Y";
478 SP = POS(0): REM MUST BE 15 (9 CHARS + 5 SPACES + 1 FOR Y)
479 VTAB 15: HTAB 1: PRINT "TAB-TEST:";: PRINT TAB(20);"Z";
480 TP = POS(0): REM MUST BE 20 (THANKS TO THE TAB)
481 HOME : PRINT "CONTINUING TEST..."
482 IF HP<>10 OR SP<>15 OR TP<>20 THEN GOTO 999
483 PRINT "TEST 5: LAYOUT... OK"

600 REM --- TEST 6: READ, DATA, RESTORE ---
610 PRINT "TEST 6: DATA... ";
620 READ X,Y:RESTORE:READ W,Z
630 IF X<>10 OR Y<>20 OR W<>10 OR Z<>20 THEN GOTO 999
640 PRINT "OK"

700 REM --- TEST 7: MEMORY AND LOGIC (PEEK/POKE) ---
710 PRINT "TEST 7: MEMORY/LOGIC... ";
720 POKE 768, 55:V = PEEK(768): REM PAGE 3 FREE RAM
730 B1 = (5 > 3) AND (2 < 4):B2 = (1 = 2) OR (4 > 3):B3 = NOT(1 = 2)
740 IF V<>55 OR B1<>1 OR B2<>1 OR B3<>1 THEN GOTO 999
750 PRINT "OK"

800 REM --- TEST 8: GOSUB / RETURN ---
810 PRINT "TEST 8: SUBROUTINE... ";
820 GOSUB 2000
830 IF SR <> 42 THEN GOTO 999
840 PRINT "OK"

900 REM === FINAL VERDICT ===
910 PRINT : PRINT "*** ALL SYSTEM TESTS OK! ***"
920 END

999 PRINT "ERROR ON TESTED LINE!": END

2000 SR = 42: RETURN : REM SUBROUTINE FOR TEST 8

