10 REM BENCH2 V2 FOR APPLE II / PRODOS APPLESOFT
20 IF PEEK(49312)<>193 THEN PRINT "TIMER UNAVAILABLE. UPDATE FIRMWARE.":END
30 DIM XE(9),YE(9),MA(9),MB(9):FOR K=1 TO 9:READ XE(K),YE(K),MA(K),MB(K):NEXT K
40 INPUT "SCALE (1-9)";Q:IF Q<1 OR Q>9 OR Q<>INT(Q) THEN 40
50 DIM F(250)
60 PRINT:PRINT "BENCH2 V2 SCALE=";Q
70 PRINT "@BEGIN INTEGER"
80 X=1:Y=1:I=0:D=0:GOSUB 1000:S=T:L=T
90 FOR B=1 TO 8*Q
100 FOR K=1 TO 25
110 I=I+1:X=X+I:Y=Y+X
120 IF X>30000 THEN X=X-30000
130 IF Y>30000 THEN Y=Y-30000
140 NEXT K
150 GOSUB 1100
160 NEXT B
170 GOSUB 1000:E=T-S:IF E<0 THEN E=E+4294967296
190 IF D THEN PRINT:D=0
200 IF X<>XE(Q) OR Y<>YE(Q) THEN PRINT "@END INTEGER FAIL":END
210 PRINT "@END INTEGER PASS X=";X;" Y=";Y
220 M=MA(Q):GOSUB 1200
230 PRINT "@BEGIN SIEVE"
240 D=0:GOSUB 1000:S=T:L=T
250 FOR R=1 TO Q
260 FOR I=2 TO 250:F(I)=0:NEXT I
265 GOSUB 1100
270 FOR P=2 TO 15
280 IF F(P)=0 THEN FOR K=P*P TO 250 STEP P:F(K)=1:NEXT K
290 NEXT P
295 GOSUB 1100
300 C=0:FOR I=2 TO 250:IF F(I)=0 THEN C=C+1
310 NEXT I
320 IF C<>53 THEN 360
330 GOSUB 1100
340 NEXT R
350 GOTO 370
360 IF D THEN PRINT:D=0
365 PRINT "@END SIEVE FAIL":END
370 GOSUB 1000:E=T-S:IF E<0 THEN E=E+4294967296
380 IF D THEN PRINT:D=0
390 PRINT "@END SIEVE PASS PRIMES=";C
400 M=MB(Q):GOSUB 1200
410 PRINT "@DONE PASS"
420 END
500 DATA 20101,3601,5368,5070
510 DATA 20201,7201,10940,10002
520 DATA 301,801,16544,14937
530 DATA 20401,4401,22085,19873
540 DATA 20501,8001,27681,24813
550 DATA 601,1601,33309,29754
560 DATA 20701,5201,38916,34698
570 DATA 20801,8801,44545,39644
580 DATA 901,2401,50211,44586
1000 T=PEEK(49313)+PEEK(49314)*256+PEEK(49315)*65536+PEEK(49316)*16777216
1010 RETURN
1100 GOSUB 1000
1110 IF T<L THEN L=T
1120 IF T-L>=5000 THEN PRINT ".";:L=T:D=1
1130 RETURN
1200 PRINT "  ELAPSED: ";E;" MS"
1210 PRINT "  6502 MODEL ONLY (NOT MEASURED): 1.023MHZ=";M;" MS"
1220 IF E<1 THEN PRINT "  INDEX UNAVAILABLE: ELAPSED <1 MS. INCREASE SCALE.":RETURN
1230 PRINT "  INDEX VS 1.023MHZ MODEL: ";INT(M*100/E);" (100=MODEL, HIGHER=FASTER; THEORETICAL)"
1240 IF E<1000 THEN PRINT "  SHORT RUN: INCREASE SCALE FOR BETTER TIMING ACCURACY."
1250 RETURN
