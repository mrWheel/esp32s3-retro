;
; CHKMEM.A86  [For IBM-Compatibles]
; Display Amount Of Conventional Memory, Free Memory And Extended Memory
; Freeware from Kirk Lawrence and Ken Mauro
;
        cseg                            ;start of code segment
        org     100h                    ;leave room for base page
        jmp     start                   ;go start the program
;
m_base  dw      0                       ;
m_len   dw      0                       ;storage variable for # of paragraphs
m_ext   db      0                       ;
tot     db      13,10,'       0 bytes conventional memory.$'
fre     db      13,10,'       0 bytes free.',13,10,'$'
;
start:
        int     12h                     ;get system memory (in AX)
        mov     dx,64                   ;convert to paragraphs
        mul     dx                      ; "
        mov     m_len,ax                ;save result in variable
        mov     dx,16                   ;convert to bytes
        mul     dx                      ; "
        mov     di,offset tot + 10      ;convert to decimal ASCII
        call    dec8                    ; "
        call    strip0                  ; "
        mov     cl,9                    ;function 9 - print string
        mov     dx,offset tot           ;point to our screen message
        int     224                     ;call BDOS
cpmfre:
        mov     cl,35h                  ;bdos# 53: get maxmem       
        mov     dx,offset m_base        ;point to memory control block
        int     224                     ;go to daddy.
        mov     ax, m_len
        mov     dx,16                   ;convert to bytes
        mul     dx                      ; "
        mov     di,offset fre + 10      ;convert to decimal ASCII
        call    dec8                    ; "
        call    strip0                  ; "
        mov     cl,9                    ;function 9 - print string
        mov     dx,offset fre           ;point to our screen message
        int     224                     ;call BDOS
        mov     cl,39h                  ;bdos# 57: freemem(m_len)
        mov     dx,offset m_base        ;prev allocated mcb 
        int     224                     ;go to daddy
;
        xor     cx,cx                   ;function 0 - reset system
        xor     dx,dx                   ;sub-function 0 - total exit
        int     224                     ;call BDOS
;
strip0:
        cmp     byte ptr [di],'0'       ;is [DI] zero?
        jne     strip1                  ;no, so we're done
        inc     di                      ;increment DI
        cmp     byte ptr [di],'0'       ;is next byte non-numeric?
        jl      strip1                  ;yes, so we're done
        cmp     byte ptr [di],'9'       ;
        jg      strip1                  ;
        dec     di                      ;decrement DI
        mov     byte ptr [di],' '       ;replace zero with space
        inc     di                      ;point to next character
        jmp     strip0                  ;repeat
strip1:
        ret                             ;return
;
dec2:
        push    ax                      ;preserve registers
        push    bx                      ; "
        xor     ah,ah                   ;clear AH
        mov     bl,10                   ;AH=AX%10, AL=AX/10
        div     bl                      ;
        add     ax,'00'                 ;convert to ASCII
        sub     di,2                    ;
        mov     [di],ax                 ;store in string
        pop     bx                      ;restore registers
        pop     ax                      ; "
        ret                             ;return
;
dec4:
        push    ax                      ;preserve registers
        push    bx                      ; "
        mov     bl,100                  ;AH=AX%100, AL=AX/100
        div     bl                      ;
        xchg    ah,al                   ;convert 2 LSD's
        call    dec2                    ;
        xchg    ah,al                   ;convert 2 MSD's
        call    dec2                    ;
        pop     bx                      ;restore registers
        pop     ax                      ; "
        ret                             ;return
;
dec8:
        push    ax                      ;preserve registers
        push    bx                      ; "
        push    dx                      ; "
        mov     bx,10000                ;DX=DX:AX%10000, AX=DX:AX/10000
        div     bx                      ; "
        xchg    dx,ax                   ;convert 4 LSD's
        call    dec4                    ; "
        xchg    dx,ax                   ;convert 4 MSD's
        call    dec4                    ; "
        pop     dx                      ;restore registers
        pop     bx                      ; "
        pop     ax                      ; "
        ret                             ;return
end

